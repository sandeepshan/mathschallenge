{
  "name": "Maths Champions — Grade 5 Practice",
  "short_name": "Maths Champions",
  "description": "Adaptive maths practice with results, growth tracking and achievements — with progress that follows you across devices.",
  "id": "/",
  "start_url": "./index.html",
